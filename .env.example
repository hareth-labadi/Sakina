# Copy to .env.local. Nothing here is secret yet.

# When the backend exists, point the services layer at it.
# Empty = use the in-app mock data (src/services/mock).
NEXT_PUBLIC_API_URL=

# Where the dev server forwards /api/* (the API from `cd backend && npm run dev`).
# Empty = no forwarding.
API_INTERNAL_URL=http://localhost:4000
