# Optional: copy to .env.local to override. Nothing here is secret.

# Where the browser calls the API. Empty = /api on the same origin (the normal setup).
NEXT_PUBLIC_API_URL=

# Where the server forwards /api/*. Empty = http://localhost:4000 in development
# (the API from `cd backend && npm run dev`); compose.yaml sets it for the Docker image.
API_INTERNAL_URL=
