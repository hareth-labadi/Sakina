# Copy to backend/.env for `npm run dev`, `npm run db:migrate` and `npm test`.
# Matches the services in compose.dev.yaml (local only, not real secrets).
DATABASE_URL=postgres://sakina:sakina-dev@localhost:15432/sakina
LOG_LEVEL=debug

# The web app's address: emailed links point here, and only requests from it are accepted.
PUBLIC_WEB_URL=http://localhost:3000

# Encrypts recovery emails. Generate your own: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Mailpit from compose.dev.yaml; read the emails at http://localhost:8025.
# Empty = emails are printed to the API console instead.
SMTP_URL=smtp://localhost:1025
