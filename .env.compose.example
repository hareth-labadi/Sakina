# Copy to .env (gitignored) before `docker compose up`. Read by compose.yaml only.

# Letters, digits and "-" only: it goes inside a connection URL.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Encrypts recovery emails. Generate: openssl rand -base64 32
# Keep it safe and never change it casually: without it, stored recovery emails can't be read.
DATA_ENCRYPTION_KEY=

# The address people open in the browser. Emailed links point here; other origins are refused.
PUBLIC_WEB_URL=http://localhost:3000

# Outgoing email (smtp://user:pass@host:587). Empty: emails are not sent.
SMTP_URL=
MAIL_FROM=Sakina <no-reply@sakina.invalid>
